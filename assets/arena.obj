# Analytic planes: floor, ceiling, side walls.
# Coordinates are pre-swapped because ArenaMesh::loadMeshObj reads OBJ vertices as y x z.
# Floor z=0
v -6000.0 -4096.0 0.0
v -6000.0 4096.0 0.0
v 6000.0 4096.0 0.0
v 6000.0 -4096.0 0.0

# Ceiling z=2048
v -6000.0 -4096.0 2048.0
v 6000.0 -4096.0 2048.0
v 6000.0 4096.0 2048.0
v -6000.0 4096.0 2048.0

# +X side wall x=4096
v -3840.0 4096.0 0.0
v -3840.0 4096.0 2048.0
v 3840.0 4096.0 2048.0
v 3840.0 4096.0 0.0

# -X side wall x=-4096
v -3840.0 -4096.0 0.0
v 3840.0 -4096.0 0.0
v 3840.0 -4096.0 2048.0
v -3840.0 -4096.0 2048.0

